# Backend API Base URL
VITE_API_URL=http://localhost:5000

# ============================================================================
# AUTHENTICATION TOKEN
# ============================================================================

# Admin Access Token
VITE_ADMIN_TOKEN="6444ffb6471fa51325e158c042c837bfaf5d65103eff1a1cb6738c914da9028c62919c84c933f6d073bf4e78516535f89e406c6ed3a24cc79a75cd315c61ab45"

# Admin User Email (for display purposes)
VITE_ADMIN_EMAIL=admin@example.com

# Admin User Name (for display purposes)
VITE_ADMIN_NAME=Admin User

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment mode (development/production)
VITE_NODE_ENV=production

# ============================================================================
# AI CONTENT GENERATION (Optional)
# ============================================================================

# N8N Webhook URL for blog content generation (optional)
# VITE_N8N_WEBHOOK_URL=http://your-n8n-instance.com/webhook/blog

# N8N Webhook URL for newsletter content generation (optional)
# VITE_N8N_NEWSLETTER_WEBHOOK_URL=http://your-n8n-instance.com/webhook/newsletter

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Copy this file to .env:
#    cp env.example .env
#
# 2. Update VITE_ADMIN_TOKEN to match your backend ADMIN_TOKEN
#    - Check your backend .env file for ADMIN_TOKEN value
#    - Set the same value here
#
# 3. If your backend runs on a different port/URL:
#    - Update VITE_API_URL to your backend URL
#    - Or update the proxy in vite.config.ts
#
# 4. Restart your frontend dev server after changing .env
#
# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# - All Vite environment variables must be prefixed with VITE_
# - Changes to .env require a server restart to take effect
# - Never commit .env file to version control
# - The VITE_ADMIN_TOKEN must exactly match the backend ADMIN_TOKEN

